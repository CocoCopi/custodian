# Copy to .env and adjust before `docker compose up -d`.

# Public domain where the console is served (no scheme).
CUSTODIAN_DOMAIN=paas.example.com

# Control plane secrets — generate with: openssl rand -hex 32
CUSTODIAN_JWT_SECRET=change-me-to-a-long-random-string

# Database credentials
CUSTODIAN_DB_USER=custodian
CUSTODIAN_DB_PASSWORD=change-me
CUSTODIAN_DB_NAME=custodian

# MinIO object storage
CUSTODIAN_MINIO_USER=custodian
CUSTODIAN_MINIO_PASSWORD=change-me-too

# Grafana dashboard
CUSTODIAN_GRAFANA_USER=admin
CUSTODIAN_GRAFANA_PASSWORD=change-me-three

# Let's Encrypt contact email
CUSTODIAN_LETSENCRYPT_EMAIL=admin@example.com

# Deployment engine: compose (single server) or k3s (cluster)
CUSTODIAN_ENGINE=compose

# Optional OIDC provider (Keycloak / Authelia / Google Workspace / etc.)
CUSTODIAN_OIDC_ISSUER=
CUSTODIAN_OIDC_CLIENT_ID=
CUSTODIAN_OIDC_CLIENT_SECRET=
CUSTODIAN_OIDC_REDIRECT_URL=https://api.paas.example.com/api/v1/auth/callback
